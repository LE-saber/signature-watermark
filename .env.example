# Keep this file private.
# At least 12 characters. This password deterministically derives both
# blind_watermark password_img and password_wm.
WATERMARK_PASSWORD=CHANGE_THIS_TO_A_LONG_PRIVATE_PASSWORD

# Carrier defaults. Background mode itself is selected each run.
CARRIER_PADDING=64
CARRIER_ALPHA=96
CARRIER_FEATHER=48
TEXTURE_STRENGTH=4
